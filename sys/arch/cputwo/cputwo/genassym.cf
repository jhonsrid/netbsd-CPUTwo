include <sys/param.h>
include <sys/lwp.h>
include <sys/proc.h>

include <machine/frame.h>
include <machine/pcb.h>
include <machine/cpu.h>

# trapframe offsets
define	TF_R0		offsetof(struct trapframe, tf_r[0])
define	TF_R1		offsetof(struct trapframe, tf_r[1])
define	TF_R2		offsetof(struct trapframe, tf_r[2])
define	TF_R3		offsetof(struct trapframe, tf_r[3])
define	TF_R4		offsetof(struct trapframe, tf_r[4])
define	TF_R5		offsetof(struct trapframe, tf_r[5])
define	TF_R6		offsetof(struct trapframe, tf_r[6])
define	TF_R7		offsetof(struct trapframe, tf_r[7])
define	TF_R8		offsetof(struct trapframe, tf_r[8])
define	TF_R9		offsetof(struct trapframe, tf_r[9])
define	TF_R10		offsetof(struct trapframe, tf_r[10])
define	TF_R11		offsetof(struct trapframe, tf_r[11])
define	TF_R12		offsetof(struct trapframe, tf_r[12])
define	TF_SP		offsetof(struct trapframe, tf_r[13])
define	TF_LR		offsetof(struct trapframe, tf_r[14])
define	TF_PC		offsetof(struct trapframe, tf_pc)
define	TF_STATUS	offsetof(struct trapframe, tf_status)
define	TF_EFLAGS	offsetof(struct trapframe, tf_eflags)
define	TF_CAUSE	offsetof(struct trapframe, tf_cause)
define	TF_SIZE		sizeof(struct trapframe)

# switchframe offsets
define	SF_R4		offsetof(struct switchframe, sf_r4)
define	SF_R5		offsetof(struct switchframe, sf_r5)
define	SF_R6		offsetof(struct switchframe, sf_r6)
define	SF_R7		offsetof(struct switchframe, sf_r7)
define	SF_R8		offsetof(struct switchframe, sf_r8)
define	SF_R9		offsetof(struct switchframe, sf_r9)
define	SF_R10		offsetof(struct switchframe, sf_r10)
define	SF_R11		offsetof(struct switchframe, sf_r11)
define	SF_SP		offsetof(struct switchframe, sf_sp)
define	SF_LR		offsetof(struct switchframe, sf_lr)
define	SF_SIZE		sizeof(struct switchframe)

# pcb offsets
define	PCB_SF		offsetof(struct pcb, pcb_sf)
define	PCB_ONFAULT	offsetof(struct pcb, pcb_onfault)
define	PCB_TF		offsetof(struct pcb, pcb_tf)

# lwp offsets
define	L_PCB		offsetof(struct lwp, l_addr)
define	L_CPU		offsetof(struct lwp, l_cpu)

# cpu_info offsets
define	CI_CURLWP	offsetof(struct cpu_info, ci_curlwp)
define	CI_CPL		offsetof(struct cpu_info, ci_cpl)
define	CI_IDEPTH	offsetof(struct cpu_info, ci_intr_depth)
define	CI_MTX_COUNT	offsetof(struct cpu_info, ci_mtx_count)
