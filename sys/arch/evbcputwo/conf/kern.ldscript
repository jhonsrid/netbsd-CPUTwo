/* NetBSD/evbcputwo kernel linker script */
OUTPUT_FORMAT("elf32-cputwo")
OUTPUT_ARCH(cputwo)
ENTRY(start)

SECTIONS
{
    . = 0x00000000;

    .text : {
        *(.text .text.*)
        *(.stub)
    }

    . = ALIGN(4096);
    .rodata : {
        *(.rodata .rodata.*)
    }

    . = ALIGN(4096);
    .data : {
        *(.data .data.*)
    }

    . = ALIGN(4);
    __bss_start = .;
    .bss : {
        *(.bss .bss.*)
        *(COMMON)
    }
    _end = .;
    PROVIDE(end = .);
    PROVIDE(edata = ADDR(.bss));

    /DISCARD/ : {
        *(.comment)
        *(.note.GNU-stack)
    }
}
