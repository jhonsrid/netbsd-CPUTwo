#	$NetBSD$

machine		evbcputwo cputwo
include		"conf/std"		# MI standard options

options		EXEC_ELF32		# exec ELF32 binaries

makeoptions	DEFTEXTADDR="0x80000000"
makeoptions	BOARDTYPE="evbcputwo"
makeoptions	BOARDMKFRAG="${CPUTWO}/conf/mk.evbcputwo"

include "arch/cputwo/conf/files.cputwo"
include "arch/evbcputwo/conf/files.evbcputwo"
